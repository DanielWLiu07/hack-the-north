{
  "index_patterns": ["robot-telemetry*"],
  "data_stream": {},
  "priority": 200,
  "template": {
    "settings": {
      "index.mode": "time_series",
      "index.routing_path": ["signal"],
      "index.look_back_time": "7d"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp":      { "type": "date" },
        "signal":          { "type": "keyword", "time_series_dimension": true },
        "value":           { "type": "double",  "time_series_metric": "gauge" },
        "sentry_trace_id": { "type": "keyword" },
        "sentry_span_id":  { "type": "keyword" },
        "sentry_url":      { "type": "keyword" }
      }
    },
    "lifecycle": {
      "data_retention": "7d",
      "downsampling": [
        { "after": "1h", "fixed_interval": "5m" },
        { "after": "6h", "fixed_interval": "30m" }
      ]
    }
  }
}
