# ─────────────────────────────────────────────────────────────────────────────
#  GITSPACE — credentials and config
#
#  Copy to `.env` and fill in. `.env` must NEVER be committed (it's in
#  .gitignore-to-be). Everything marked [TONIGHT] should be obtained before the
#  event — venue wifi and signup queues are not where you want to be at hour 20.
#
#  Column key:   [TONIGHT] get it now   [BOOTH] collect at the sponsor booth
#                [T2]/[T3] only needed for later tiers   [OPT] optional
# ─────────────────────────────────────────────────────────────────────────────


# ══ NETWORK — our own router, static IPs ════════════════════════════ [TONIGHT]
# Set these once the travel router is up. Everything else assumes them.
PI_HOST=192.168.2.10              # the Raspberry Pi
PI_PORT=8080                      # HTTP + WebSocket (same port)
LAPTOP_IP=192.168.2.24            # the laptop — Rerun listens here
RERUN_ADDR=rerun+http://192.168.2.24:9876/proxy
HOOKS_PORT=9000                   # roomctl webhook server (only if not using SQS)


# ══ ELASTICSEARCH ═══════════════════════════════ [TONIGHT] track/elastic ════
# cloud.elastic.co → Serverless → **Elasticsearch** project type.
# (Agent Builder is GA and on-by-default on Serverless; on Hosted it needs
#  Stack 9.3+/Enterprise and may simply not be there.)
# API key: Kibana → Stack Management → API keys.
# Our project is on GCP us-east4, not AWS — the web tier reaches it cross-cloud (docs/19).
ELASTIC_URL=https://xxxxx.es.us-east4.gcp.elastic.cloud:443
ELASTIC_API_KEY=
# Cloud-level ORG key (cloud.elastic.co -> Organization -> API keys).
# Lets the setup scripts create the Serverless project and read the endpoint back.
# Starts with essu_ . Different from ELASTIC_API_KEY above (per-project).
ELASTIC_CLOUD_API_KEY=
# Optional alternative to URL+key on some clients:
# ELASTIC_CLOUD_ID=

# Inference endpoint IDs we create in setup_elastic.py — names, not secrets.
ES_INFERENCE_EMBED=jina-embed
ES_INFERENCE_RERANK=jina-rerank


# ══ JINA ═══════════════════════════════════════════════ [TONIGHT] [maybe] ═══
# ONLY needed if the Elastic Inference Service doesn't already serve
# jina-embeddings-v3 for your project. Check that first — if EIS covers it,
# leave this blank and skip the signup. Free tier at jina.ai.
JINA_API_KEY=


# ══ OPENAI ══════════════════════════════════════════ [BOOTH] [TONIGHT] ══════
# GPT-5 vision for per-view object descriptions, and the Realtime API for voice.
# OpenAI sponsors the API prize and hands out CREDITS AT THEIR BOOTH — collect
# them Friday morning before the queue. With credits, running the VLM three
# times per object (which is what makes hybrid search meaningful) is free.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5
OPENAI_REALTIME_MODEL=gpt-realtime


# ══ SENTRY ════════════════════════════════ [TONIGHT] TARGET PRIZE ═══════════
# Strategy: docs/18-sentry.md.  TWO projects on sentry.io:
#   1. "gitspace"     platform Python  → used by the Pi, the laptop AND the AWS
#                                        web server. One DSN, three machines.
#                                        server_name distinguishes them, and the
#                                        distributed trace still joins into one
#                                        waterfall.
#   2. "gitspace-web" platform Browser → the dashboard. Separate DSN because
#                                        Session Replay is a browser-SDK feature.
SENTRY_DSN=
SENTRY_DSN_WEB=
# Org auth token — lets the setup scripts create the projects, read the DSNs back and
# query issues/traces during the build. sentry.io -> Settings -> Auth Tokens.
# Scopes: org:read, project:read, project:write, event:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=

SENTRY_ENVIRONMENT=htn2026
SENTRY_RELEASE=gitspace@0.1.0
# 1.0 = capture everything. It's a 36-hour hackathon on a tiny event volume —
# sampling would only hide the one trace you needed.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_REPLAYS_SAMPLE_RATE=1.0
# The "gitspace robot" internal integration's token (Settings > Developer Settings > Custom
# Integrations). robot_sentry.py resolves issues with it, so Sentry names the ROBOT as the actor.
SENTRY_ROBOT_TOKEN=
# SENTRY_SERVER_NAME is set PER MACHINE, not here: "pi" | "laptop" | "web"


# ══ AWS WEB TIER ═══════════════════════════════════════════════ [OPT] ═══════
# t4g.small, no GPU — it's a FastAPI proxy. See docs/19-deployment.md.
# The dashboard queries Elasticsearch DIRECTLY, so it stays up even if the
# laptop sleeps. Only /api/command and /api/resolve route back via SQS.
WEB_PUBLIC_URL=https://gitspace.<yourdomain>      # Sentry Uptime watches this
WEB_BIND=0.0.0.0:8000
WEB_ALLOWED_COMMANDS=status,diff,log,search,revert,checkout,resolve   # allow-list


# ══ AWS ════════════════════════════════════════════════════════ [OPT] ═══════
# No AWS prize at this event — use only where it genuinely helps:
#   S3  = point-cloud blobs (so the laptop isn't a single point of failure)
#   SNS = outbound SMS alerts
#   SQS = inbound webhooks WITHOUT poking a hole in venue wifi
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

S3_BUCKET=gitspace-clouds          # set a 7-day lifecycle rule so it expires
SQS_QUEUE_URL=                     # only if doing the GitHub PR beat
SNS_ALERT_NUMBERS=+1519XXXXXXX     # comma-separated; SMS sandbox requires
                                   # verifying each destination number first


# ══ MESSAGING ══════════════════════════════════════════════════ [OPT] ═══════
# Telegram is the recommended two-way channel: ~10 min, no phone number, no
# 10DLC registration, and it can send images (the Rerun screenshot).
# @BotFather → /newbot → token. Chat id: message the bot, then check getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ══ VOICE ══════════════════════════════════════════════════════ [OPT] ═══════
# ElevenLabs replaces the stock Kokoro TTS. ~30 min, materially better demo.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ══ MODEL HOSTING ══════════════════════════════════════════════ [OPT] ═══════
# Baseten hosts SAM 3 / the VLM so the Pi doesn't have to. Also the right call
# architecturally. Collect credits at their booth.
BASETEN_API_KEY=
BASETEN_MODEL_ID=

# HuggingFace — needed for LeRobot and for pulling model weights.
# GET THIS TONIGHT and pre-download weights; don't rely on venue wifi.
HF_TOKEN=


# ══ GITHUB ═════════════════════════════════════════════════ [T3] [OPT] ══════
# Only for the "pull request against physical space" beat.
GITHUB_TOKEN=                      # repo scope, to post PR comments back
GITHUB_WEBHOOK_SECRET=             # verify X-Hub-Signature-256 in the Lambda
ROOM_REPO=DanielWLiu07/room        # the ROOM repo, not the code repo


# ══ LOCAL PATHS ═════════════════════════════════════════════════════════════
ROOM_GIT_PATH=./room.git           # the room's own repo — SEPARATE from the code
CLOUD_CACHE_DIR=./clouds           # .ply files before S3 upload
CALIB_PATH=./perception/calib      # stereo + extrinsics YAML. Pin and never move.
# Model weights live OUTSIDE the repo so they survive a re-clone or `rm -rf .venv`.
# scripts/bootstrap_laptop.sh fills it; the venv then resolves YOLO("yolo11s-seg.pt")
# from here with no network.
MODELS_DIR=${HOME}/.cache/gitspace/models
# telemetry/hub.py. Both OUTSIDE the repo: the spool is ES backfill; the frames are photographs
# of the room (one attached per robot-failure report). Neither may ride into a commit.
TELEMETRY_SPOOL=${HOME}/.cache/gitspace/telemetry-spool
FRAME_CACHE_DIR=${HOME}/.cache/gitspace/frames
# WEB_EVENTS_URL=http://127.0.0.1:8000/api/internal/event   # default: derived from WEB_BIND
# web/jobs.py: the job ledger Andrew's edge polls (GET /api/jobs/{id}) and reports to. Files, outside the repo.
JOBS_DIR=${HOME}/.cache/gitspace/jobs


# ══ GITIRL-AGENT EDGE (Andrew) ═════════════════════════════════════ [OPT] ═══
# POST /api/jobs/{id}/result needs `Authorization: Bearer <this>`: a robot claiming it moved something.
# >= 32 chars; unset = every result refused (fail closed). The SAME value is HIS GITIRL_CLOUD_TOKEN.
# Make one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
GITIRL_CLOUD_TOKEN=
# The user's go-ahead for the REAL robot to run jobs. Unset = every job says "motion": "mock_only".
# JOBS_REAL_MOTION=1

# ══ HOUSEBOT EDGE (Andrew's executor, PLAN.md §0) ════════════════════ [OPT] ═══
# web/housebot.py POSTs point / move jobs to $HOUSEBOT_EDGE_URL/v1/jobs (his scripts/run_edge_api.py, :8780).
# Unset = the dispatcher is OFF (jobs say executor: not_connected). A kind is sent only when it is on
# WEB_ALLOWED_COMMANDS (`point`, `move`). The token is HIS edge's HOUSEBOT_EDGE_TOKEN (same value both sides).
HOUSEBOT_EDGE_URL=
HOUSEBOT_EDGE_TOKEN=
# HOUSEBOT_EDGE_TIMEOUT_S=120   # his /v1/jobs answers when the robot is done; after this it's `unknown`, never re-sent
# Andrew's understanding layer (bridge/intents.py): asked ONLY when our grammar has no match. Unset = refuse.
ANDREW_INTENT_URL=
# ANDREW_INTENT_TOKEN=


# ══ SCENE CONSTANTS — pin these once, then NEVER change them ════════════════
# Every octree key in Elasticsearch is relative to this cube. Changing origin or
# size silently invalidates all history, with no error message.
ROOM_ORIGIN_X=-4.0
ROOM_ORIGIN_Y=-4.0
ROOM_ORIGIN_Z=0.0
ROOM_CUBE_SIZE=8.0                 # metres — a CUBE, not the room's bbox
OCTREE_LEVELS=7                    # 8 m / 2^7 = 6.25 cm cells
QUANT_POSITION_M=0.01              # 1 cm
QUANT_YAW_DEG=5
ANCHOR_TAG_ID=0                    # the AprilTag that defines the world origin
